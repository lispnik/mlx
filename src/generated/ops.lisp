(defun mlx:all (a &key (axis nil) (keepdims nil) stream)
  "Dispatches on axis: nil -> mlx_all, int -> mlx_all_axis, list -> mlx_all_axes."
  (etypecase axis
    (null (%all a :keepdims keepdims :stream stream))
    (integer (mlx:all-axis a axis :keepdims keepdims :stream stream))
