;;;; tests/nn.lisp -- mlx.nn and mlx.optimizers
;;;;
;;;; The *-REFERENCE tables were produced by Python MLX 0.32.1 (mlx.nn,
;;;; mlx.optimizers) on the same inputs, so these tests check parity.

(in-package :mlx-tests)

(def-suite :mlx.nn :in :mlx)
(in-suite :mlx.nn)

(defparameter *activation-reference*
  '(
    ("relu" 0.0 0.0 0.0 0.7 3.0)
    ("relu6" 0.0 0.0 0.0 2.1 6.0)
    ("leaky-relu" -0.02 -0.005 0.0 0.7 3.0)
    ("elu" -0.864665 -0.393469 0.0 0.7 3.0)
    ("selu" -1.520162 -0.691756 0.0 0.73549 3.1521)
    ("celu" -0.864665 -0.393469 0.0 0.7 3.0)
    ("gelu" -0.0455 -0.154269 0.0 0.530625 2.99595)
    ("gelu-approx" -0.045402 -0.154286 0.0 0.53057 2.996363)
    ("gelu-fast-approx" -0.064341 -0.149612 0.0 0.536894 2.981929)
    ("silu" -0.238406 -0.18877 0.0 0.467731 2.857722)
    ("mish" -0.252501 -0.220744 0.0 0.561148 2.986535)
    ("softplus" 0.126928 0.474077 0.693147 1.103186 3.048587)
    ("softsign" -0.666667 -0.333333 0.0 0.411765 0.75)
    ("log-sigmoid" -2.126928 -0.974077 -0.693147 -0.403186 -0.048587)
    ("hardswish" -0.333333 -0.208333 0.0 0.431667 3.0)
    ("hard-tanh" -1.0 -0.5 0.0 0.7 1.0)
    ("log-softmax" -5.171413 -3.671413 -3.171413 -2.471413 -0.171413)
    ("step" 0.0 0.0 1.0 1.0 1.0)
